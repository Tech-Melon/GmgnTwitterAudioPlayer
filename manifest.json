{
    "manifest_version": 3,
    "name": "GMGN 盯盘伴侣",
    "version": "1.15.0",
    "description": "高度可定制的GMGN twitter音频播报插件(X: 0xTechMelon)",
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "offscreen"
    ],
    "host_permissions": [
        "*://*.gmgn.ai/*",
        "*://gmgn.ai/*"
    ],
    "optional_host_permissions": [
        "http://127.0.0.1:37921/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.gmgn.ai/*",
                "*://gmgn.ai/*"
            ],
            "js": [
                "lib/twitter-event.js",
                "inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.gmgn.ai/*",
                "*://gmgn.ai/*"
            ],
            "js": [
                "lib/wallet-event.js",
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js",
                "sounds/default.MP3",
                "sounds/preset1.MP3",
                "sounds/elonmusk.MP3",
                "sounds/cz.MP3",
                "sounds/heyi.MP3"
            ],
            "matches": [
                "*://*.gmgn.ai/*",
                "*://gmgn.ai/*"
            ]
        }
    ]
}
